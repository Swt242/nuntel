// 设置窗口 —— 一个**独立的系统窗口**,不是主窗口里的浮层。
//
// 跟主窗口一样是无边框的,自己画标题栏、自己拖(WindowMoveArea)。
// 不同的是它是**固定尺寸**的:设置面板没有缩放的意义,写死 `width`/`height`
// 正好(按 Slint 文档,Window 的 `width` 就是固定宽度;要可缩放才得用 `preferred-*`)。
//
// ⚠️ 这个窗口有自己的一份 Theme / AppData / Logic 实例(全局单例不跨窗口共享,
// 见 widgets.slint 顶部的说明)。宿主必须把主题**分别推给两个窗口**,
// 否则切外观时这里不会跟着变。

import {
    AppData, Appearance, Backdrop, Chip, PanelEdge, Logic, Slider, Theme, ThemePreference,
    TodoCheck, Toggle, VCenter, WindowButton,
} from "widgets.slint";

/// 外观预览小图。
///
/// 里面这几个颜色是**刻意抄**的一份,没有直接引 Theme ——
/// Theme.blob-* / grid-line 在别的外观下是 transparent(见 Theme 里的说明),
/// 真引了的话,一切到原主题,「毛玻璃」「工业风」那两张预览就跟着变空白,
/// 三张卡长得一模一样,预览就没意义了。预览图要**永远画自己那套**。
component MiniPreview inherits Rectangle {
    in property <Appearance> style: Appearance.solid;
    in property <bool> dark: false;

    property <bool> is-glass: style == Appearance.glass;
    property <bool> is-industrial: style == Appearance.industrial;

    // 毛玻璃那两团柔光(照抄 Theme 里 glass 那份的值)
    property <color> blob-a: dark ? #7c5cff94 : #8b5cf6cc;
    property <color> blob-b: dark ? #22d3ee80 : #0ea5e9a6;
    // 三套的面板填充 / 描边 / 页面底色,都写全
    property <color> surface:
        is-industrial ? (dark ? #181a18 : #f2f2ec)
        : is-glass    ? (dark ? #ffffff26 : #ffffff75)
        :               (dark ? #1a1d24 : #ffffff);
    property <color> line:
        is-industrial ? (dark ? #343633 : #d8d9d5)
        : is-glass    ? (dark ? #ffffff26 : #ffffffd9)
        :               (dark ? #2a2f3a : #e2e6ec);
    property <color> page:
        is-industrial ? (dark ? #101110 : #e8e8e2)
        : is-glass    ? (dark ? #080b16 : #c9d5f2)
        :               (dark ? #0f1115 : #eef0f4);
    // 工业风的信号黄(顶上那根横线 + 那块选中的小方块)
    property <color> signal: dark ? #fff500 : #fff500;

    border-radius: 7px * Theme.radius-scale;
    clip: true;
    border-width: 1px;
    border-color: line;
    background: page;

    // 底衬色斑:光用平涂看不出「毛玻璃」和其他两套的区别,
    // 有颜色透上来才是毛玻璃那张卡的重点。
    if is-glass : Rectangle {
        x: -10px;
        y: -18px;
        width: 78px;
        height: 78px;
        background: @radial-gradient(
            circle, root.blob-a 0%, root.blob-a.with-alpha(0) 70%,
        );
    }
    if is-glass : Rectangle {
        x: 52px;
        y: 10px;
        width: 74px;
        height: 74px;
        background: @radial-gradient(
            circle, root.blob-b 0%, root.blob-b.with-alpha(0) 70%,
        );
    }

    // 工业风的坐标网格。缩略图里不必还原真实密度,两三根线就够把"方格纸"说出来。
    if is-industrial : Rectangle {
        x: 32px;
        y: 0;
        width: 1px;
        height: parent.height;
        background: dark ? #1a1d1a : #dcdcd6;
    }
    if is-industrial : Rectangle {
        x: 64px;
        y: 0;
        width: 1px;
        height: parent.height;
        background: dark ? #1a1d1a : #dcdcd6;
    }
    if is-industrial : Rectangle {
        x: 96px;
        y: 0;
        width: 1px;
        height: parent.height;
        background: dark ? #1a1d1a : #dcdcd6;
    }

    // 标题条
    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: 14px;
        background: root.surface;
        border-width: 1px;
        border-color: root.line;
    }
    // 工业风:标题条顶边那根信号黄横线 —— 整套风格里最显眼的一处强调色
    if is-industrial : Rectangle {
        x: 0;
        y: 0;
        width: parent.width * 0.45;
        height: 2px;
        background: root.signal;
    }

    // 两块「任务卡」
    Rectangle {
        x: 9px;
        y: 22px;
        width: parent.width - 18px;
        height: 13px;
        border-radius: 4px * Theme.radius-scale;
        background: root.surface;
        border-width: 1px;
        border-color: root.line;
    }
    Rectangle {
        x: 9px;
        y: 40px;
        width: parent.width - 18px;
        height: 13px;
        border-radius: 4px * Theme.radius-scale;
        background: root.surface;
        border-width: 1px;
        border-color: root.line;
    }
    // 工业风:左下角一块信号黄的小方块(对应界面上的勾选框/徽标)
    if is-industrial : Rectangle {
        x: 9px;
        y: 22px;
        width: 5px;
        height: 13px;
        background: root.signal;
    }
}

/// 一张外观选项卡:预览图 + 名字 + 选中态
component AppearanceCard inherits Rectangle {
    in property <string> label;
    in property <Appearance> style: Appearance.solid;
    in property <bool> selected: false;

    callback clicked();

    height: 112px;
    border-radius: 11px * Theme.radius-scale;
    border-width: 2px;
    border-color: selected ? Theme.accent-ink : Theme.border;
    background: selected ? Theme.accent-soft : Theme.card;

    animate background { duration: 150ms; }
    animate border-color { duration: 150ms; }

    VerticalLayout {
        padding: 10px;
        spacing: 8px;

        MiniPreview {
            style: root.style;
            height: 64px;
        }

        HorizontalLayout {
            height: 20px;
            spacing: 6px;

            Text {
                text: root.label;
                font-size: 13px;
                font-weight: root.selected ? 600 : 400;
                color: root.selected ? Theme.accent-ink : Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            // 用 opacity 开关而不是 `if selected:` —— 让这个 14px 的位置**恒定占着**,
            // 否则选中时标签会被勾挤窄一格,点来点去文字会左右跳。
            Image {
                source: @image-url("icons/check.svg");
                width: 14px;
                height: 14px;
                colorize: Theme.accent-ink;
                opacity: root.selected ? 1 : 0;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component SettingsWindow inherits Window {
    title: "待办清单 · 设置";
    // 固定尺寸:设置面板不需要缩放。写 `width`/`height` 就是固定(见 Slint 文档)。
    // 宽度按三张外观卡排得下来定的:(520 - 2×16 内边距 - 2×12 间距) / 3 ≈ 154。
    width: 520px;
    // 高度按内容量出来的:外观三张卡 + 亮暗一行 + 启动一行 + 桌宠大小
    // + 跟随那三行(开关/静止多久/速度)+ 动画列表的列头 + 10 个动画各一行。
    // 加动画(往 assets/pet 里丢素材)或加一节都要跟着加高 —— 布局不会自己撑开窗口。
    height: 970px;
    background: Theme.bg;
    no-frame: true;
    icon: @image-url("icons/app.svg");
    default-font-size: 14px;

    // ── 拖动排序的状态(见下面动画列表那段说明)──
    //
    // 拖的过程**纯视觉**:模型一个字都不动,松手那一刻才发 `move-pet-anim`。
    private property <string> drag-name: "";
    private property <int> drag-from: -1;
    /// 松手会落在第几位(拖动中实时算)
    private property <int> drag-to: -1;
    /// 按下时指针的**绝对** y
    private property <length> drag-y0: 0px;
    /// 一行占多高 = 行高 22 + 列表 spacing 4。**改行高就得改这里**
    private property <length> anim-row-step: 26px;

    // 底衬:跟主窗口同一个组件,切外观时这里也跟着变
    Backdrop {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
    }

    body := Rectangle {
        y: 36px;
        width: parent.width;
        height: parent.height - 36px;
        background: transparent;

        VerticalLayout {
            padding: 16px;
            spacing: 10px;

            Text {
                text: "外观主题";
                font-size: 13px;
                font-weight: 600;
                color: Theme.text;
            }

            HorizontalLayout {
                spacing: 12px;

                card-solid := AppearanceCard {
                    label: "原主题";
                    style: Appearance.solid;
                    selected: Theme.appearance == Appearance.solid;
                    horizontal-stretch: 1;
                    clicked => { Logic.set-appearance(Appearance.solid); }
                }

                card-glass := AppearanceCard {
                    label: "毛玻璃";
                    style: Appearance.glass;
                    selected: Theme.appearance == Appearance.glass;
                    horizontal-stretch: 1;
                    clicked => { Logic.set-appearance(Appearance.glass); }
                }

                card-industrial := AppearanceCard {
                    label: "工业风";
                    style: Appearance.industrial;
                    selected: Theme.appearance == Appearance.industrial;
                    horizontal-stretch: 1;
                    clicked => { Logic.set-appearance(Appearance.industrial); }
                }
            }

            Text {
                text: "选中立刻生效,并记到下次启动";
                font-size: 11px;
                color: Theme.text-dim;
            }

            // ── 亮暗 ──
            // 和「外观主题」挨着放:两个都是外观维度,一共 3×2 种组合。
            // (原先主窗口标题行有个太阳/月亮按钮能切,已经挪过来了 ——
            //  同一件事有两个入口,用户不一定找得到另一个。)
            //
            // 判据用 `Theme.dark`(算过的结果)而不是 `Theme.preference`:
            // 老数据里 preference 可能是 system,那样两个 Chip 会都不亮;
            // Theme.dark 在跟随系统时也已经解析成了实际的亮/暗。
            Text {
                text: "亮暗";
                font-size: 13px;
                font-weight: 600;
                color: Theme.text;
            }

            HorizontalLayout {
                spacing: 8px;

                Chip {
                    label: "亮色";
                    selected: !Theme.dark;
                    clicked => { Logic.set-theme-preference(ThemePreference.light); }
                }

                Chip {
                    label: "暗色";
                    selected: Theme.dark;
                    clicked => { Logic.set-theme-preference(ThemePreference.dark); }
                }
            }

            // ── 启动 ──
            // 开机自启原来是主窗口底栏上那个开关,挪过来了 ——
            // 和「外观 / 亮暗」一个道理:都是设置,就该在设置里找得到。
            Rectangle {
                height: 1px;
                background: Theme.border;
            }

            Text {
                text: "启动";
                font-size: 13px;
                font-weight: 600;
                color: Theme.text;
            }

            autostart-toggle := Toggle {
                label: "开机自启";
                checked: AppData.autostart;
                // 开关状态**以宿主为准**:写注册表可能失败(企业策略、权限),
                // 失败时宿主会把开关拨回来,不能停在骗人的状态上。
                toggled => { Logic.set-autostart(self.checked); }
            }

            Text {
                text: "开机时自动运行(写 HKCU,不需要管理员)";
                font-size: 11px;
                color: Theme.text-dim;
            }

            // ── 桌宠 ──
            // 两个都是**边拖边生效**的:拖动时立刻看到/看到宠物的变化,
            // 而不是松手才动一下。数字显示在右边,拖到位了看得见具体值。
            Rectangle {
                height: 1px;
                background: Theme.border;
            }

            Text {
                text: "桌宠";
                font-size: 13px;
                font-weight: 600;
                color: Theme.text;
            }

            pet-size-row := HorizontalLayout {
                spacing: 10px;

                Text {
                    text: "大小";
                    width: 48px;
                    font-size: 12px;
                    color: Theme.text-dim;
                    vertical-alignment: center;
                }

                Slider {
                    min: 64;
                    max: 200;
                    value: AppData.pet-size;
                    horizontal-stretch: 1;
                    moved-to(v) => { Logic.set-pet-size(v); }
                }

                Text {
                    text: "\{Math.round(AppData.pet-size)} px";
                    width: 52px;
                    font-size: 12px;
                    color: Theme.text;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }

            // ── 每个动画:开关 + 拖动排序 + 单独调速 ──
            //
            // 一行一个动画:[☰ 手柄] [勾选框] [名字] [滑杆] [倍率]。
            // **不做两列**:名字最长有 6 个字(「待机·纸飞机」),挤成两列就得砍名字。
            //
            // 列表本身由宿主推(动画名来自 assets/pet/manifest.json,加动画不用改这里),
            // 而且**这个顺序就是待机轮播的顺序** —— 拖的就是它。
            //
            // ⚠️ 三条别改回去:
            // 1. **拖动过程中一个字都不许推回列表** —— `for` 会把整行重建,正在拖的那一行
            //    (以及它上面那根滑杆)会被换掉,手势当场断掉。所以拖动只在本地算落点,
            //    松手那一刻才发 `move-pet-anim` 让宿主改顺序。
            // 2. **勾选反过来:必须推**(宿主 `set_pet_anim_enabled` 里推)——
            //    勾选框的 `checked` 读的是模型里的 `enabled`,不推的话勾子根本不刷新。
            //    两种操作看着像,要求正好相反,别一概而论。
            // 3. 行高 22 + 列表 spacing 4 = `anim-row-step`(26),落点就是按这个算的;
            //    改行高要同步改它,否则拖动会算错位置。
            // ── 跟随鼠标(§40)──
            //
            // 鼠标静止够久之后,宠物自己慢慢走过去(不实时跟)。走过去用哪个动画,
            // 由下面动画列表里的「跟随」勾选框决定:只有正在播勾上的那些动画时才出发,
            // 而且**走过去的时候不切动画**,接着播它当时那个。
            Toggle {
                label: "鼠标静止后跟着走";
                checked: AppData.pet-follow;
                toggled => { Logic.set-pet-follow(!AppData.pet-follow); }
            }

            // 静止多久才出发
            HorizontalLayout {
                spacing: 8px;

                Text {
                    text: "静止";
                    width: 48px;
                    font-size: 12px;
                    color: Theme.text-dim;
                    vertical-alignment: center;
                }

                Slider {
                    min: 3;
                    max: 60;
                    value: AppData.pet-follow-delay;
                    // 跟随关掉时这两根滑杆一起灰掉(复用 Slider 的 enabled)
                    enabled: AppData.pet-follow;
                    horizontal-stretch: 1;
                    moved-to(v) => { Logic.set-pet-follow-delay(v); }
                }

                Text {
                    text: "\{Math.round(AppData.pet-follow-delay)} 秒";
                    width: 52px;
                    font-size: 12px;
                    color: AppData.pet-follow ? Theme.text : Theme.text-dim;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }

            // 走路速度(倍率,1 = 基准速度)
            HorizontalLayout {
                spacing: 8px;

                Text {
                    text: "速度";
                    width: 48px;
                    font-size: 12px;
                    color: Theme.text-dim;
                    vertical-alignment: center;
                }

                Slider {
                    min: 0.25;
                    max: 3;
                    value: AppData.pet-follow-speed;
                    enabled: AppData.pet-follow;
                    horizontal-stretch: 1;
                    moved-to(v) => { Logic.set-pet-follow-speed(v); }
                }

                Text {
                    text: "\{Math.round(AppData.pet-follow-speed * 100) / 100}×";
                    width: 52px;
                    font-size: 12px;
                    color: AppData.pet-follow ? Theme.text : Theme.text-dim;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }

            // 列头:两个勾选框各管什么,一眼看清(和下面每行的列宽对齐)
            HorizontalLayout {
                height: 16px;
                spacing: 8px;

                Text {
                    text: "☰";
                    width: 14px;
                    font-size: 10px;
                    color: Theme.text-dim;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                Text {
                    text: "轮播";
                    width: 22px;
                    font-size: 10px;
                    color: Theme.text-dim;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                Text {
                    text: "跟随";
                    width: 22px;
                    font-size: 10px;
                    color: Theme.text-dim;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                Text {
                    // 两个手势都得说清:点是看、拖是排。底下那行高亮的就是正在演的
                    text: "☰ 点一下:桌宠当场演一遍(再点收工);按住拖动排序,顺序就是轮播顺序";
                    font-size: 11px;
                    color: Theme.text-dim;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            // 外面这层只为把行距收紧(外层 VerticalLayout 的 spacing 是 10,
            // 10 行就多出去 60px;列表本身也该排得比「区块之间」密)
            VerticalLayout {
                spacing: 4px;
                // 不参与拉伸:否则窗口高一点点,这段就会被居中/均分,
                // 每一行的位置跟着飘 —— 靠坐标点击来验证/自动化时会莫名其妙点空。
                vertical-stretch: 0;

                // 每行套一层 Rectangle:① 好让「松手会落到这儿」的那行亮一下;
                // ② 被拖起来的那行整体淡下去。行高仍然是 22(窗口高度不用动)。
                for anim[i] in AppData.pet-anims : Rectangle {
                    // 「桌宠正在演这个」的那一行 —— 判据是宿主推的 `AppData.pet-preview`。
                    // 它是**单独一个全局属性**,不是 PetAnim 里的字段:改它不会重建
                    // 这个列表,而点 ☰ 的同时很可能正按着在拖动(§39 那条)。
                    height: 22px;
                    background: root.drag-name != "" && root.drag-to == i
                        ? Theme.accent-soft
                        : (AppData.pet-preview == anim.name ? Theme.accent-soft : transparent);
                    opacity: root.drag-name == anim.name ? 0.35 : 1;

                    HorizontalLayout {
                        width: parent.width;
                        height: parent.height;
                        spacing: 8px;

                        // ── 拖动手柄:三条横线 ──
                        // 不用「☰」那个字符:字体里有没有、多宽都不确定,画出来更稳
                        Rectangle {
                            property <bool> lit:
                                root.drag-name == anim.name
                                    || AppData.pet-preview == anim.name;

                            width: 14px;
                            height: parent.height;
                            background: transparent;

                            Rectangle {
                                width: 10px; height: 1px; x: 2px; y: 8px;
                                background: lit ? Theme.accent-ink : Theme.text-dim;
                            }
                            Rectangle {
                                width: 10px; height: 1px; x: 2px; y: 11px;
                                background: lit ? Theme.accent-ink : Theme.text-dim;
                            }
                            Rectangle {
                                width: 10px; height: 1px; x: 2px; y: 14px;
                                background: lit ? Theme.accent-ink : Theme.text-dim;
                            }

                            TouchArea {
                                mouse-cursor: grab;
                                changed pressed => {
                                    if (self.pressed) {
                                        // **点一下 = 让真桌宠演一遍**(设置页里没有缩略图,
                                        // 预览就是桌宠本人;它按这一行自己的速度播,所以
                                        // 拖速度滑杆时能当场看出快慢)。再点同一个 = 收工。
                                        // 直接拖着走也没关系:那会儿它就在演你拖的这一行。
                                        Logic.preview-pet-anim(anim.name);
                                        root.drag-name = anim.name;
                                        root.drag-from = i;
                                        root.drag-to = i;
                                        // 指针的**绝对** y —— 不能用窗口内坐标(见 pet.slint 那个坑)
                                        root.drag-y0 = self.absolute-position.y + self.mouse-y;
                                    } else {
                                        if (root.drag-name != "" && root.drag-to >= 0) {
                                            Logic.move-pet-anim(root.drag-name, root.drag-to);
                                        }
                                        root.drag-name = "";
                                        root.drag-from = -1;
                                        root.drag-to = -1;
                                    }
                                }
                                moved => {
                                    // 走了几行 = 位移 / 行距(四舍五入),再夹到 0..n-1
                                    root.drag-to = clamp(
                                        root.drag-from + Math.round(
                                            (self.absolute-position.y + self.mouse-y - root.drag-y0)
                                                / root.anim-row-step
                                        ),
                                        0,
                                        AppData.pet-anims.length - 1,
                                    );
                                }
                            }
                        }

                        // ── 轮播开关:关掉的一律不播(待机轮播跳过,看书/购物也不切)──
                        VCenter {
                            TodoCheck {
                                checked: anim.enabled;
                                toggled => { Logic.set-pet-anim-enabled(anim.name, !anim.enabled); }
                            }
                        }

                        // ── 跟随开关:在这个动画期间允不允许「跟着鼠标走」──
                        // 和上面那个是两件事:可以关掉轮播、只让它负责走过去
                        VCenter {
                            TodoCheck {
                                checked: anim.follow;
                                toggled => { Logic.set-pet-follow-anim(anim.name, !anim.follow); }
                            }
                        }

                        Text {
                            text: anim.label;
                            width: 72px;
                            font-size: 12px;
                            // 正在试演的那个名字挑出来;关掉的那行淡下去(一眼看出它不参与)
                            color: AppData.pet-preview == anim.name ? Theme.accent-ink
                                : (anim.enabled ? Theme.text-dim : Theme.border-strong);
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        Slider {
                            min: 0.25;
                            max: 3;
                            value: anim.speed;
                            enabled: anim.enabled;
                            horizontal-stretch: 1;
                            moved-to(v) => { Logic.set-pet-anim-speed(anim.name, v); }
                        }

                        Text {
                            // 两位小数:1.25× 这种中间值也要看得出区别
                            text: "\{Math.round(anim.speed * 100) / 100}×";
                            width: 44px;
                            font-size: 12px;
                            color: anim.enabled ? Theme.text : Theme.text-dim;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

    // 标题栏:画在最后 = 浮在最上层(跟主窗口一个套路)
    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: 36px;
        background: Theme.card;
        border-width: 1px;
        border-color: Theme.border;

        PanelEdge { width: parent.width - 2px; }

        move-area := WindowMoveArea {
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 4px;
                spacing: 8px;

                Text {
                    text: "设置";
                    font-size: 12px;
                    color: Theme.text-dim;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                VCenter {
                    win-close := WindowButton {
                        icon: @image-url("icons/win-close.svg");
                        danger: true;
                        clicked => { Logic.close-settings(); }
                    }
                }
            }
        }
    }
}
